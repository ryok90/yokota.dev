---
import electrolizeUrl from '../assets/fonts/Electrolize-Regular.woff2?url';
import interUrl from '../assets/fonts/Inter-Regular.woff2?url';
import portraitSquare from '../assets/portrait-square.jpg';
import { lastModified } from '../lib/last-modified.mjs';
import { HOME_PAGE_ID, PERSON_ID, SITE_URL, WEBSITE_ID } from '../lib/schema';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** The homepage is the canonical profile of the person; every other route is a WebPage. */
  pageType?: 'WebPage' | 'ProfilePage';
  /**
   * Page-specific graph nodes, built by the page from its own content arrays so the data has
   * exactly one home. A `BreadcrumbList` among them is linked from the page node.
   */
  schemaNodes?: Record<string, unknown>[];
  /** Keep a 200-status error document out of the index. */
  noindex?: boolean;
}

const {
  title,
  description,
  pageType = 'WebPage',
  schemaNodes = [],
  noindex = false,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
// Preview builds can reference a published card while production stays on its canonical domain.
const socialImageUrl = new URL(import.meta.env.SOCIAL_IMAGE_URL ?? '/og-card.jpg', Astro.site);
// Zephyr's static hosting answers unknown paths with the homepage document instead of 404.html,
// so the document served at `/` is also the catch-all. Only that document carries the route
// guard below; every real route is served from its own file and can never be a fallback hit.
const isFallbackDocument = Astro.url.pathname === '/';
// It runs before anything paints, so a fallback hit never flashes the homepage. The document
// keeps the platform's 200 status, which is why 404.astro also sends `noindex`.
const routeGuard =
  "if (location.pathname !== '/' && location.pathname !== '/index.html') location.replace('/404.html');";
// Google Analytics 4. Zephyr version URLs are subdomains of the apex
// (`<version>-...-ze.yokota.dev`) and render canonical yokota.dev markup, so the tag is
// gated on an exact apex hostname match. Loosening that to a suffix test would track every build.
const GA_MEASUREMENT_ID = 'G-EYT1QRFKV1';

const SITE_DESCRIPTION =
  'Portfolio of Rodrigo Yokota, a Platform Engineer building deployment infrastructure, federated frontend tooling, and agent platforms.';
// The portrait, not the social card: a 1200x630 card with type on it is a poor entity image.
const portraitUrl = new URL(portraitSquare.src, Astro.site).href;
// Git-derived, so a rebuild with no content change does not claim a new modification date.
const modifiedAt = lastModified(Astro.url.pathname);

// One linked graph instead of an isolated Person on every page: crawlers and answer engines
// resolve `@id` references, so each document points at the same person and site entity.
const person = {
  '@type': 'Person',
  '@id': PERSON_ID,
  name: 'Rodrigo Yokota',
  alternateName: 'ryok90',
  url: `${SITE_URL}/`,
  mainEntityOfPage: { '@id': HOME_PAGE_ID },
  description:
    'Platform Engineer working across build systems, cloud delivery, and developer experience.',
  jobTitle: 'Platform Engineer',
  email: 'rodrigo@yokota.dev',
  image: {
    '@type': 'ImageObject',
    url: portraitUrl,
    contentUrl: portraitUrl,
    width: portraitSquare.width,
    height: portraitSquare.height,
    caption: 'Rodrigo Yokota, Platform Engineer',
  },
  // The role wrapper carries the start date the homepage timeline already states.
  worksFor: {
    '@type': 'OrganizationRole',
    roleName: 'Platform Engineer',
    startDate: '2023-11',
    worksFor: {
      '@type': 'Organization',
      name: 'Zephyr Cloud',
      url: 'https://zephyr-cloud.io',
    },
  },
  hasOccupation: {
    '@type': 'Occupation',
    name: 'Platform Engineer',
    // O*NET-SOC code for software developers, the identifier schema.org's own examples use.
    occupationalCategory: '15-1252.00',
    skills: 'Module Federation, build tooling, deployment pipelines, TypeScript, Node.js, AWS',
  },
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    name: 'AWS Certified Cloud Practitioner',
    credentialCategory: 'certification',
    recognizedBy: {
      '@type': 'Organization',
      name: 'Amazon Web Services',
      url: 'https://aws.amazon.com',
    },
  },
  knowsLanguage: [
    { '@type': 'Language', name: 'Portuguese', alternateName: 'pt-BR' },
    { '@type': 'Language', name: 'English', alternateName: 'en' },
  ],
  nationality: { '@type': 'Country', name: 'Brazil' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Curitiba',
    addressRegion: 'PR',
    addressCountry: 'BR',
  },
  sameAs: [
    'https://github.com/ryok90',
    'https://www.linkedin.com/in/rodrigo-yokota/',
    'https://x.com/ryok90',
  ],
  knowsAbout: [
    'Platform engineering',
    'Module Federation',
    'Build tooling',
    'Cloud deployment pipelines',
    'Agent platforms',
    'TypeScript',
    'Node.js',
    'Rspack',
  ],
};

const website = {
  '@type': 'WebSite',
  '@id': WEBSITE_ID,
  url: `${SITE_URL}/`,
  name: 'Rodrigo Yokota',
  alternateName: 'yokota.dev',
  description: SITE_DESCRIPTION,
  inLanguage: 'en',
  publisher: { '@id': PERSON_ID },
};

const breadcrumb = schemaNodes.find((node) => node['@type'] === 'BreadcrumbList');

const webPage = {
  '@type': pageType,
  '@id': `${canonicalUrl.href}#webpage`,
  url: canonicalUrl.href,
  name: title,
  description,
  inLanguage: 'en',
  isPartOf: { '@id': WEBSITE_ID },
  // ProfilePage requires the profiled entity as `mainEntity`; other routes are only about it.
  ...(pageType === 'ProfilePage'
    ? { mainEntity: { '@id': PERSON_ID } }
    : { about: { '@id': PERSON_ID } }),
  ...(breadcrumb ? { breadcrumb: { '@id': breadcrumb['@id'] } } : {}),
  ...(modifiedAt ? { dateModified: modifiedAt.toISOString() } : {}),
};

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [person, website, webPage, ...schemaNodes],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    {isFallbackDocument && <script is:inline set:html={routeGuard} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Rodrigo Yokota" />
    <meta name="theme-color" content="#090b0d" />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <link rel="icon" href="/images/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href={electrolizeUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rodrigo Yokota" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="Rodrigo Yokota, Platform Engineer" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@ryok90" />
    <meta name="twitter:site" content="@ryok90" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="Rodrigo Yokota, Platform Engineer" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
      if (location.hostname === 'yokota.dev') {
        const tag = document.createElement('script');
        tag.async = true;
        tag.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_MEASUREMENT_ID;
        document.head.append(tag);

        window.dataLayer = window.dataLayer || [];
        window.gtag = function gtag() {
          window.dataLayer.push(arguments);
        };
        window.gtag('js', new Date());
        window.gtag('config', GA_MEASUREMENT_ID);
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
